# Application
APP_NAME=pr-review-assistant
DEBUG=false
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/review

# Redis
REDIS_URL=redis://redis:6379/0

# GitHub
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# or GitHub App
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# LLM
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_MOCK=true

# Review limits
MAX_DIFF_FILES=30
MAX_DIFF_LINES=2000
